# N64 Web Streaming MVP Configuration

# Path to the ROM file to stream
ROM_PATH=/roms/game.z64

# Mupen64Plus plugin path
MUPEN_PLUGIN_PATH=/usr/lib/mupen64plus

# Server configuration
PORT=3000
HOST=0.0.0.0

# WebRTC configuration
STUN_SERVER=stun:stun.l.google.com:19302

# Pion WebRTC server configuration
PION_HTTP_PORT=8080
PION_RTP_PORT=5004
PION_URL=http://localhost:8080

# Video encoding settings
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FRAMERATE=60
VIDEO_BITRATE=2M

# Save state directory
SAVESTATE_PATH=./savestates

# Logging
LOG_LEVEL=info
NODE_ENV=development
